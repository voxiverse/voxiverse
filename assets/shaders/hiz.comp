#version 460

// The depth pyramid (render/hiz.odin, hiz_build): one dispatch per level.
// Each texel of the level written is the minimum of the source texels it
// covers: in reverse Z (near 1, far 0) the farthest depth there. Level 0
// reads the frame's depth image, whose size need not be twice level 0's: a
// texel covers source texels [floor(x * W / w), ceil((x + 1) * W / w))
// across (likewise down), so every source texel is in some texel's
// footprint. Each level below reads the one above, exactly 2 x 2 (or 1 on an
// axis already 1 wide). hiz_reference (hiz.odin) is the same on the CPU.
//
// The source is read with gathers (four texels a read, unfiltered: the
// minimum stays exact), which the development machine's GPU does faster
// than the texel fetches it replaces.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D source; // the depth image, or the level above
layout(set = 0, binding = 1, r32f) uniform writeonly image2D target;
layout(set = 0, binding = 2) uniform sampler nearest; // clamped to the edge

layout(push_constant) uniform Push {
	uvec2 source_size;
	uvec2 target_size;
} push;

// The minimum of the 2 x 2 source texels from `base` (one gather), or of
// its first column or row alone where `two` is false on that axis.
float gather_min(uvec2 base, bvec2 two) {
	// At the corner shared by texels base and base + 1: the gather's four.
	vec4 v = textureGather(sampler2D(source, nearest), (vec2(base) + 1.0) / vec2(push.source_size));
	// x (i0, j1), y (i1, j1), z (i1, j0), w (i0, j0)
	float m = v.w;
	if (two.x) m = min(m, v.z);
	if (two.y) m = min(m, v.x);
	if (two.x && two.y) m = min(m, v.y);
	return m;
}

void main() {
	uvec2 t = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(t, push.target_size))) {
		return;
	}
	// The target is a power of two on each axis: the divisions are shifts.
	uvec2 shift = uvec2(findMSB(push.target_size.x), findMSB(push.target_size.y));
	uvec2 lo = (t * push.source_size) >> shift;
	uvec2 hi = ((t + 1u) * push.source_size + push.target_size - 1u) >> shift;
	// The source is under twice the target: a footprint is 1 to 3 texels
	// each way, so one gather, or two or four overlapping (a texel read twice
	// changes no minimum).
	uvec2 w = hi - lo;
	bvec2 two = greaterThan(w, uvec2(1u));
	float farthest = gather_min(lo, two);
	if (w.x == 3u) farthest = min(farthest, gather_min(lo + uvec2(1u, 0u), two));
	if (w.y == 3u) farthest = min(farthest, gather_min(lo + uvec2(0u, 1u), two));
	if (w.x == 3u && w.y == 3u) farthest = min(farthest, gather_min(lo + uvec2(1u, 1u), two));
	imageStore(target, ivec2(t), vec4(farthest));
}
