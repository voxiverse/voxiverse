# glass: break, place and step.
sound glass.break
  class block_break
  length 0.6
  gain -2 dB
  layer transient
    delay 0.0012
    source click 0.85..0.95
    envelope attack 0 hold 0 decay 0.01
    filter highpass 2500
    level -30 dB
  layer body
    delay 0.0012
    source modal glass hardness 0.85..0.95 spread 0.94..1.06 length 0.0002 decay 1.5
    envelope attack 0 hold 0 decay 0.4375..0.625 curve exp
    pitch 0.8..0.92
    filter highpass 1000
    level 24 dB
  layer debris
    delay 0.0012
    source granular modal glass count 12..20 size 0.004..0.012 pitch 0.8..1.6 gain -8..0 dB spread 0.02..0.5 density front
    envelope attack 0 hold 0.05 decay 0.4
    level 1 dB
end

