package mesh

import "core:math"

import "../../game"

// Block textures: one layer per Texture in a texture array, generated by
// code (see generate_texture). Which layer each block face uses:

Texture :: enum u32 {
	Stone,
	Dirt,
	Grass_Top,
	Grass_Side,
	Sand,
	Gravel,
}

@(private = "file", rodata)
BLOCK_TEXTURES := [game.Block][3]Texture { 	// side, top, bottom
	.Air    = {},
	.Stone  = {.Stone, .Stone, .Stone},
	.Dirt   = {.Dirt, .Dirt, .Dirt},
	.Grass  = {.Grass_Side, .Grass_Top, .Dirt},
	.Sand   = {.Sand, .Sand, .Sand},
	.Gravel = {.Gravel, .Gravel, .Gravel},
}

block_texture :: proc(b: game.Block, f: Face) -> u32 {
	t := BLOCK_TEXTURES[b]
	#partial switch f {
	case .Pos_Y:
		return u32(t[1])
	case .Neg_Y:
		return u32(t[2])
	}
	return u32(t[0])
}

// Generated pixels: TEXTURE_SIZE² RGBA8 (sRGB) per layer, plus mip levels
// down to 1×1 averaged in linear light.

TEXTURE_SIZE :: 16
TEXTURE_MIPS :: 5 // 16, 8, 4, 2, 1

Rgba :: [4]u8

// generate_texture fills pixels (TEXTURE_SIZE² values, row by row) for t.
// Deterministic: the same on every machine and every run.
generate_texture :: proc(t: Texture, pixels: []Rgba) {
	assert(len(pixels) == TEXTURE_SIZE * TEXTURE_SIZE)
	seed := u32(t) * 0x9e37_79b9
	for y in 0 ..< TEXTURE_SIZE {
		for x in 0 ..< TEXTURE_SIZE {
			// Pixel noise and a smoother 4-pixel noise, both tiling.
			fine := hash01(seed, x, y)
			coarse := value_noise(seed ~ 0x5bd1_e995, x, y, 4)
			c: [3]f32
			switch t {
			case .Stone:
				v := 0.42 + 0.10 * coarse + 0.08 * fine
				if hash01(seed ~ 7, x, y) > 0.93 {v -= 0.10} 	// dark specks
				c = {v, v, v * 1.02}
			case .Dirt:
				c = dirt(seed, x, y, fine, coarse)
			case .Grass_Top:
				c = grass(fine, coarse)
			case .Grass_Side:
				// Grass hangs 3-5 pixels over the dirt, with a ragged edge.
				edge := 3 + int(hash01(seed ~ 3, x, 0) * 2.99)
				c = grass(fine, coarse) if y < edge else dirt(seed, x, y, fine, coarse)
			case .Sand:
				v := 0.80 + 0.05 * coarse + 0.06 * fine
				c = {v, v * 0.92, v * 0.68}
			case .Gravel:
				// Pebbles: cells of one tone each, with darker gaps.
				cell := value_noise(seed ~ 11, x, y, 3)
				v := 0.35 + 0.25 * cell + 0.05 * fine
				if hash01(seed ~ 13, x, y) > 0.85 {v *= 0.7}
				c = {v * 1.04, v, v * 0.95}
			}
			pixels[y * TEXTURE_SIZE + x] = {to_u8(c.r), to_u8(c.g), to_u8(c.b), 255}
		}
	}
}

// generate_mip halves src (size² pixels) into dst ((size/2)² pixels),
// averaging in linear light so distant surfaces keep their brightness.
generate_mip :: proc(src: []Rgba, size: int, dst: []Rgba) {
	half := size / 2
	assert(len(src) == size * size && len(dst) == half * half)
	for y in 0 ..< half {
		for x in 0 ..< half {
			sum: [4]f32
			for d in ([4][2]int{{0, 0}, {1, 0}, {0, 1}, {1, 1}}) {
				p := src[(2 * y + d[1]) * size + 2 * x + d[0]]
				sum += {
					srgb_to_linear(p.r),
					srgb_to_linear(p.g),
					srgb_to_linear(p.b),
					f32(p.a) / 255,
				}
			}
			sum /= 4
			dst[y * half + x] = {
				linear_to_srgb(sum.r),
				linear_to_srgb(sum.g),
				linear_to_srgb(sum.b),
				u8(sum.a * 255 + 0.5),
			}
		}
	}
}

@(private = "file")
dirt :: proc(seed: u32, x, y: int, fine, coarse: f32) -> [3]f32 {
	v := 0.36 + 0.08 * coarse + 0.08 * fine
	if hash01(seed ~ 5, x, y) > 0.9 {v += 0.08} 	// small stones
	return {v, v * 0.72, v * 0.48}
}

@(private = "file")
grass :: proc(fine, coarse: f32) -> [3]f32 {
	v := 0.40 + 0.10 * coarse + 0.10 * fine
	return {v * 0.55, v, v * 0.35}
}

// hash01 is a well-mixed hash of (seed, x, y) in 0..1.
@(private = "file")
hash01 :: proc(seed: u32, x, y: int) -> f32 {
	h := seed ~ u32(x) * 0x27d4_eb2d ~ u32(y) * 0x1656_67b1
	h = (h ~ h >> 15) * 0x85eb_ca6b
	h = (h ~ h >> 13) * 0xc2b2_ae35
	h ~= h >> 16
	return f32(h >> 8) / f32(1 << 24)
}

// value_noise interpolates hash01 on a grid of cell pixels, wrapping at the
// texture size so the texture tiles.
@(private = "file")
value_noise :: proc(seed: u32, x, y, cell: int) -> f32 {
	cells := TEXTURE_SIZE / cell
	gx, gy := x / cell, y / cell
	fx, fy := f32(x % cell) / f32(cell), f32(y % cell) / f32(cell)
	at :: proc(seed: u32, gx, gy, cells: int) -> f32 {
		return hash01(seed, gx % cells, gy % cells)
	}
	a := at(seed, gx, gy, cells) * (1 - fx) + at(seed, gx + 1, gy, cells) * fx
	b := at(seed, gx, gy + 1, cells) * (1 - fx) + at(seed, gx + 1, gy + 1, cells) * fx
	return a * (1 - fy) + b * fy
}

@(private = "file")
to_u8 :: proc(v: f32) -> u8 {
	return u8(clamp(v, 0, 1) * 255 + 0.5)
}

@(private = "file")
srgb_to_linear :: proc(c: u8) -> f32 {
	v := f32(c) / 255
	return v / 12.92 if v <= 0.04045 else math.pow((v + 0.055) / 1.055, 2.4)
}

@(private = "file")
linear_to_srgb :: proc(v: f32) -> u8 {
	s := v * 12.92 if v <= 0.0031308 else 1.055 * math.pow(v, 1 / 2.4) - 0.055
	return to_u8(s)
}
