local s = 0
for i = 1, 10 do
  if i % 2 == 0 then continue end
  s = s + i
end
local j, w = 0, 0
while j < 10 do
  j = j + 1
  if j % 3 == 0 then continue end
  w = w + 1
end
local k, r = 0, 0
repeat
  k = k + 1
  if k == 2 then continue end
  r = r + k
until k >= 4
print(s, w, r)
--! expect: 25	7	8
