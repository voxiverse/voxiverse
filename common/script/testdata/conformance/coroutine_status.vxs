--! lua
local main, ismain = coroutine.running()
print(type(main), ismain, coroutine.isyieldable())
local co
co = coroutine.create(function()
  print(coroutine.status(co), coroutine.isyieldable())
  local inner = coroutine.create(function()
    print(coroutine.status(co))
    coroutine.yield()
  end)
  coroutine.resume(inner)
  print(coroutine.status(inner))
  coroutine.yield()
end)
print(coroutine.status(co))
coroutine.resume(co)
print(coroutine.status(co))
coroutine.resume(co)
print(coroutine.status(co))
--! expect: thread	true	false
--! expect: suspended
--! expect: running	true
--! expect: normal
--! expect: suspended
--! expect: suspended
--! expect: dead
