print(pcall(table.sort, {1, "x", 2}))
print(pcall(table.sort, {3, 2, 1}, function(a, b) error("cmp failed", 0) end))
print(pcall(table.sort, 5))
print(pcall(table.sort, {}, 5))
local t = {3, 1, 2}
table.sort(t, function(a, b) return a < b or true end)
print(#t)
--! expect: false	attempt to compare string with number
--! expect: false	cmp failed
--! expect: false	bad argument #1 to 'table.sort' (table expected, got number)
--! expect: false	bad argument #2 to 'table.sort' (function expected, got number)
--! expect: 3
