--! lua
print(string.byte("ABC"), string.byte("ABC", 2), string.byte("ABC", -1))
print(string.byte("ABC", 1, 3))
print(select("#", string.byte("ABC", 3, 2)))
print(string.char(72, 105, 33), string.char() == "")
print(pcall(string.char, 256))
--! expect: 65	66	67
--! expect: 65	66	67
--! expect: 0
--! expect: Hi!	true
--! expect: false	bad argument #1 to 'string.char' (value out of range)
