-- table.concat refuses what is neither a string nor a number (Lua 5.4.6's message).
print(pcall(table.concat, {1, {}, 3}))
print(pcall(table.concat, {1, 2}, ",", 1, 3))
--! expect: false	invalid value (at index 2) in table for 'concat'
--! expect: false	invalid value (at index 3) in table for 'concat'
