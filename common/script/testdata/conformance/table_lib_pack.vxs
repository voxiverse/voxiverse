--! lua
local p = table.pack(1, nil, 3)
print(p.n, p[1], p[2], p[3])
print(table.unpack({1, 2, 3}))
print(table.unpack({1, 2, 3}, 2))
print(table.unpack({1, 2, 3}, 2, 3))
print(select("#", table.unpack({}, 1, 3)))
print(table.pack().n)
local m = table.move({1, 2, 3}, 1, 3, 2)
print(m[1], m[2], m[3], m[4])
local dst = table.move({1, 2, 3}, 1, 3, 1, {})
print(#dst, dst[3])
print(pcall(table.unpack, {}, 1, 1e8))
--! expect: 3	1	nil	3
--! expect: 1	2	3
--! expect: 2	3
--! expect: 2	3
--! expect: 3
--! expect: 0
--! expect: 1	1	2	3
--! expect: 3	3
--! expect: false	too many results to unpack
