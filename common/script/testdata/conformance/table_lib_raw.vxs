-- The table library is raw: it ignores __index, __newindex and __len.
local proxy = setmetatable({}, {__index = function(_, k) return k * 10 end, __len = function() return 5 end})
print(#proxy, table.concat(proxy) == "", select("#", table.unpack(proxy)))
local log = {}
local t = setmetatable({}, {__newindex = function(t, k, v) log[#log + 1] = k rawset(t, k, v) end})
table.insert(t, "x")
print(#log, t[1])
--! expect: 5	true	0
--! expect: 0	x
