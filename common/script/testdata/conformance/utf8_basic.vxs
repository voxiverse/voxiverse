--! lua
print(utf8.char(72, 228, 8364, 128512))
print(utf8.len("häll€"), #"häll€")
print(utf8.codepoint("häll€", 1, -1))
print(utf8.offset("häll€", 3), utf8.offset("häll€", -1))
local cps = {}
for p, c in utf8.codes("aé€") do cps[#cps + 1] = p .. ":" .. c end
print(table.concat(cps, " "))
print(utf8.len("\xff"))
print(utf8.charpattern == "[\0-\x7F\xC2-\xFD][\x80-\xBF]*")
print(#utf8.char(0x10FFFF))
print(utf8.len("\xed\xa0\x80"))
--! expect: Hä€😀
