{
	// The ores, set in the ground in patches: what the miners stand on.
	"ember_ore": {"textures": {"all": "voxiverse:iron_ore"}, "sound": "voxiverse:stone"},
	"tide_ore": {"textures": {"all": "voxiverse:copper_ore"}, "sound": "voxiverse:stone"},
	"peat": {"textures": {"all": "voxiverse:coal_ore"}, "sound": "voxiverse:gravel"},
	// The machines, made of the kit's industrial materials (docs/packs.md, "Materials"). Each
	// faces the way it was placed: a miner puts out ahead, an arm takes from behind and gives
	// ahead, a splitter takes from behind and gives to both sides.
	"miner": {
		"states": {"facing": ["north", "east", "south", "west"]}, "default": {"facing": "north"},
		"material": "dark_steel", "textures": {"top": "voxiverse:hazard_stripes"},
		"place": "facing",
		"entity": {"kind": "machine", "slots": 1}
	},
	"furnace": {
		"material": "red_bricks", "textures": {"top": "voxiverse:magma"},
		"light": 9,
		"entity": {"kind": "machine", "slots": 2}
	},
	"assembler": {
		"material": "painted_blue", "textures": {"top": "voxiverse:vent"},
		"entity": {"kind": "machine", "slots": 5}
	},
	"crate": {
		"material": "spruce_panel", "textures": {"top": "voxiverse:riveted_iron", "bottom": "voxiverse:riveted_iron"},
		"entity": {"kind": "machine", "slots": 12}
	},
	"arm": {
		"states": {"facing": ["north", "east", "south", "west"]}, "default": {"facing": "north"},
		"shape": "foundry:low", "opaque": false,
		"material": "painted_yellow", "textures": {"top": "voxiverse:hazard_stripes"},
		"place": "facing",
		"entity": {"kind": "machine", "slots": 1}
	},
	"splitter": {
		"states": {"facing": ["north", "east", "south", "west"]}, "default": {"facing": "north"},
		"shape": "foundry:low", "opaque": false,
		"material": "copper",
		"place": "facing",
		"entity": {"kind": "machine", "slots": 0}
	},
	"generator": {
		"material": "pipes", "textures": {"top": "voxiverse:vent"},
		"light": 6,
		"entity": {"kind": "machine", "slots": 1}
	},
	"lab": {
		"material": "screen",
		"light": 11,
		"entity": {"kind": "machine", "slots": 2}
	},
	"pole": {"material": "riveted_iron"},
	// The conveyor: a slab that carries items the way it faces.
	"belt": {
		"states": {"facing": ["north", "east", "south", "west"]}, "default": {"facing": "north"},
		"shape": "foundry:low", "opaque": false,
		"material": "conveyor",
		"place": "facing",
		"entity": {"kind": "belt", "speed": 1.5}
	}
}
