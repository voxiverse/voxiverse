{
	// The guns are the base pack's, with Horde's tuning: these fields replace theirs
	// while Horde is played ("override"), so they load Horde's rounds (a reload takes them
	// from the pockets; with none, the gun stays empty) and hit as a wave needs. Every
	// other game's guns stay the base pack's.
	"voxiverse:pistol": {
		"override": true,
		"description": "Twelve shots a magazine. Loads rounds.",
		"weapon": {
			"damage": 4, "magazine": 12, "fire_rate": 4.0, "automatic": false, "range": 80,
			"headshot": 2.0, "zoom": 0.0, "reload_time": 1.2, "spread": 0.0, "sound": "pistol",
			"ammo": "horde:round"
		}
	},
	"voxiverse:rifle": {
		"override": true,
		"description": "Automatic. Thirty shots a magazine. Loads rounds.",
		"weapon": {
			"damage": 3, "magazine": 30, "fire_rate": 9.0, "automatic": true, "range": 90,
			"headshot": 2.0, "zoom": 0.0, "reload_time": 1.8, "spread": 0.012, "sound": "rifle",
			"ammo": "horde:round"
		}
	},
	"voxiverse:shotgun": {
		"override": true,
		"description": "Eight pellets a shot, six shots a magazine. Loads rounds.",
		"weapon": {
			"damage": 2, "magazine": 6, "fire_rate": 1.2, "automatic": false, "range": 40,
			"headshot": 1.5, "zoom": 0.0, "reload_time": 2.2, "spread": 0.1, "pellets": 8,
			"sound": "shotgun", "ammo": "horde:round"
		}
	},
	"round": {
		"model": "horde:round",
		"description": "What every gun here loads. The shop sells them.",
		"stack": 250
	}
}
