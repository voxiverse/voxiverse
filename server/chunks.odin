package server

import "base:runtime"
import "core:mem"
import "core:time"

import "../base"
import "../common/game"
import "../common/worldgen"

// The server's chunks: a fixed pool, a position -> handle map and recycled
// block arrays, all in the session arena and sized once, so memory stops
// growing once the area around the players has been loaded once.
//
// Chunks are generated by jobs on worker threads. A job gets a task with an
// array lent from the server, fills it and hands the task back through the
// done queue; the server then keeps the array (or returns it if the chunk is
// uniform). Workers never touch the pool, the map or the arena.

Chunk_Handle :: distinct u32

Chunk_State :: enum u8 {
	Generating,
	Ready,
}

Chunk :: struct {
	pos:      game.Chunk_Pos,
	state:    Chunk_State,
	blocks:   game.Chunk_Blocks,
	modified: bool, // edited since generated (saved when unloaded: save.odin)
	water:    bool, // may hold water (set when it does, never cleared): liquids skip it if not
	capture:  u32, // the running save's id while its blocks are still to be copied (save_slice.odin)
}

Chunk_Store :: struct {
	gen:           worldgen.Generator, // (each job takes a copy)
	gen_times:     base.Frame_Stats, // ms per chunk generated
	chunks:        base.Pool(Chunk, Chunk_Handle),
	by_pos:        map[game.Chunk_Pos]Chunk_Handle,
	arrays:        game.Block_Arrays,
	jobs:          base.Jobs,
	done:          base.Queue(^Gen_Task), // finished tasks, from workers
	free_tasks:    [dynamic]^Gen_Task,
	in_flight:     int,
	max_in_flight: int,
	caches:        []worldgen.Column_Cache, // one per worker (by context.user_index)
	tops_done:     [dynamic]Tops_Done, // collected, for the world to take (heap)
	cow:           ^Cow, // the running save's copies of chunks changed since its capture (heap)
}

// Cow: copy-on-write for a save that encodes over several ticks (save_slice.odin):
// before a chunk marked with the save's id changes or goes, its blocks are
// copied here.
Cow :: struct {
	id:     u32,
	copies: map[game.Chunk_Pos]game.Chunk_Blocks, // arrays owned (heap)
}

// chunk_cow copies c's blocks for the running save, if c is still marked for it.
chunk_cow :: proc(w: ^Chunk_Store, c: ^Chunk) {
	if c.capture == 0 {return}
	defer c.capture = 0
	if w.cow == nil || w.cow.id != c.capture {return}
	copy_blocks := c.blocks
	if c.blocks.array != nil {
		a := new(game.Block_Array, runtime.heap_allocator())
		a^ = c.blocks.array^
		copy_blocks.array = a
	}
	w.cow.copies[c.pos] = copy_blocks
}

// Jobs queued per worker: enough that results collected once a tick keep the
// workers busy (a chunk takes ~0.1-1 ms), few enough that a client moving
// away does not leave much stale work.
MAX_IN_FLIGHT_PER_WORKER :: 64

@(private)
Gen_Task :: struct {
	world:      ^Chunk_Store,
	gen:        worldgen.Generator, // a copy: the world's may change while this runs
	pos:        game.Chunk_Pos,
	handle:     Chunk_Handle,
	array:      ^game.Block_Array,
	uniform:    game.Block,
	is_uniform: bool,
	water:      bool, // it holds water
	skipped:    bool, // shutting down: not generated
	ms:         f32, // how long generating took
	// Or a column's natural tops instead of a chunk (chunks_request_tops):
	tops_only:  bool,
	column:     [2]i32,
	tops:       worldgen.Tops,
}

// Tops_Done: a column's natural tops worked out by a worker; fresh unless
// the generator changed meanwhile (then only the request is over).
Tops_Done :: struct {
	column: [2]i32,
	fresh:  bool,
	tops:   worldgen.Tops,
}

// chunks_init sizes the world for capacity chunks. Long-lived storage comes
// from arena; queues shared with workers from heap (thread-safe).
chunks_init :: proc(
	w: ^Chunk_Store,
	gen: worldgen.Generator,
	capacity: int,
	workers: int,
	arena: mem.Allocator,
	heap := context.allocator,
) -> mem.Allocator_Error {
	w^ = {
		gen           = gen,
		max_in_flight = max(workers, 1) * MAX_IN_FLIGHT_PER_WORKER, // (no workers: jobs run inline)
	}
	base.pool_init(&w.chunks, capacity, arena) or_return
	w.by_pos = base.map_make_fixed(map[game.Chunk_Pos]Chunk_Handle, capacity, arena) or_return
	game.block_arrays_init(&w.arrays, capacity, arena) or_return
	w.free_tasks = make([dynamic]^Gen_Task, 0, w.max_in_flight, arena) or_return
	tasks := make([]Gen_Task, w.max_in_flight, arena) or_return
	for &task in tasks {append(&w.free_tasks, &task)}
	base.queue_init(&w.done, heap)
	w.tops_done = make([dynamic]Tops_Done, heap)
	w.caches = make([]worldgen.Column_Cache, max(workers, 1), arena) or_return
	base.jobs_init(&w.jobs, "worldgen", workers, heap)
	return nil
}

// chunks_destroy stops the workers (finishing queued jobs) and frees what is
// not in the arena; the arena itself goes with the session.
chunks_destroy :: proc(w: ^Chunk_Store) {
	base.jobs_destroy(&w.jobs)
	base.queue_destroy(&w.done)
	game.block_arrays_destroy(&w.arrays)
	delete(w.tops_done)
	w^ = {}
}

// chunks_block reads one block for physics (game.Block_Query); not loaded
// while the chunk is missing or still generating.
chunks_block :: proc(data: rawptr, p: game.Block_Pos) -> (game.Block, bool) {
	c := chunks_get((^Chunk_Store)(data), game.chunk_of(p))
	if c == nil || c.state != .Ready {return .Air, false}
	return game.chunk_get(&c.blocks, game.local_of(p)), true
}

// chunks_set_block changes one block of a ready chunk; false if the chunk is
// not ready (or, impossibly, out of arrays).
chunks_set_block :: proc(w: ^Chunk_Store, p: game.Block_Pos, b: game.Block) -> bool {
	c := chunks_get(w, game.chunk_of(p))
	if c == nil || c.state != .Ready {return false}
	chunk_cow(w, c)
	if game.chunk_set(&c.blocks, &w.arrays, game.local_of(p), b) != nil {return false}
	c.modified = true
	if _, water := game.water_level(b); water {c.water = true}
	return true
}

chunks_get :: proc(w: ^Chunk_Store, pos: game.Chunk_Pos) -> ^Chunk {
	h, ok := w.by_pos[pos]
	if !ok {return nil}
	return base.pool_get(&w.chunks, h)
}

// chunks_request starts generating the chunk at pos; false when the workers
// are busy enough (try again next tick). Running out of chunk slots is a
// sizing bug: the pool is sized for everything interest can load.
chunks_request :: proc(w: ^Chunk_Store, pos: game.Chunk_Pos) -> bool {
	if w.in_flight >= w.max_in_flight {return false}
	assert(pos not_in w.by_pos)
	handle, _, ok := base.pool_add(&w.chunks, Chunk{pos = pos, state = .Generating})
	assert(ok, "chunk pool full")
	array, err := game.block_arrays_take(&w.arrays)
	assert(err == nil, "chunk arrays exhausted") // as many as pool slots
	task := pop(&w.free_tasks) // one per job in flight
	task^ = {
		world  = w,
		gen    = w.gen,
		pos    = pos,
		handle = handle,
		array  = array,
	}
	w.by_pos[pos] = handle
	w.in_flight += 1
	base.jobs_submit(&w.jobs, generate_job, task)
	return true
}

// chunks_request_tops starts working out a column's natural tops on a
// worker (they cost about as much as a chunk: never on the tick); false
// when the workers are busy. The result arrives in tops_done.
chunks_request_tops :: proc(w: ^Chunk_Store, column: [2]i32) -> bool {
	if w.in_flight >= w.max_in_flight {return false}
	task := pop(&w.free_tasks)
	task^ = {
		world     = w,
		gen       = w.gen,
		tops_only = true,
		column    = column,
	}
	w.in_flight += 1
	base.jobs_submit(&w.jobs, generate_job, task)
	return true
}

// chunks_insert adds a ready chunk from a save (blocks: uniform, or the
// contents of array copied into one of the world's).
chunks_insert :: proc(
	w: ^Chunk_Store,
	pos: game.Chunk_Pos,
	uniform: game.Block,
	array: ^game.Block_Array,
) -> ^Chunk {
	assert(pos not_in w.by_pos)
	handle, chunk, ok := base.pool_add(
		&w.chunks,
		Chunk{pos = pos, state = .Ready, modified = true},
	)
	assert(ok, "chunk pool full")
	chunk.blocks = {
		uniform = uniform,
	}
	if array != nil {
		dst, err := game.block_arrays_take(&w.arrays)
		assert(err == nil, "chunk arrays exhausted")
		dst^ = array^
		chunk.blocks = {
			array = dst,
		}
	}
	chunk.water = has_water(&chunk.blocks)
	w.by_pos[pos] = handle
	return chunk
}

// chunks_collect stores finished chunks; keep decides whether a chunk is
// still wanted (it may have left every client's interest meanwhile).
chunks_collect :: proc(
	w: ^Chunk_Store,
	keep: proc(pos: game.Chunk_Pos, data: rawptr) -> bool,
	data: rawptr,
) {
	base.profile_scope("collect chunks")
	base.metric_scope(.Server_Collect)
	done := make([dynamic]^Gen_Task, context.temp_allocator)
	base.queue_drain(&w.done, &done)
	for task in done {
		w.in_flight -= 1
		if task.tops_only {
			append(
				&w.tops_done,
				Tops_Done{task.column, !task.skipped && task.gen == w.gen, task.tops},
			)
			append(&w.free_tasks, task)
			continue
		}
		if !task.skipped {base.frame_stats_add(&w.gen_times, task.ms)}
		chunk := base.pool_get(&w.chunks, task.handle)
		assert(chunk != nil && chunk.state == .Generating, "generating chunks are never unloaded")
		chunk.state = .Ready
		chunk.water = task.water
		chunk.blocks = {
			array = task.array,
		}
		if task.is_uniform || task.skipped {
			game.block_arrays_give(&w.arrays, task.array)
			chunk.blocks = {
				uniform = task.uniform,
			}
		}
		append(&w.free_tasks, task)
		if !keep(chunk.pos, data) {chunks_unload(w, chunk.pos)}
	}
}

// chunks_unload frees a ready chunk.
chunks_unload :: proc(w: ^Chunk_Store, pos: game.Chunk_Pos) {
	h, ok := w.by_pos[pos]
	if !ok {return}
	chunk := base.pool_get(&w.chunks, h)
	assert(chunk.state == .Ready)
	chunk_cow(w, chunk)
	game.chunk_release(&chunk.blocks, &w.arrays)
	delete_key(&w.by_pos, pos)
	base.pool_remove(&w.chunks, h)
}

@(private = "file")
generate_job :: proc(data: rawptr) {
	task := (^Gen_Task)(data)
	w := task.world
	if base.jobs_stopping(&w.jobs) {
		task.skipped = true
	} else if task.tops_only {
		base.profile_scope("column tops")
		base.metric_scope(.Column_Tops)
		worldgen.column_tops(&task.gen, task.column, &task.tops, &w.caches[context.user_index])
	} else {
		base.profile_scope("generate chunk")
		base.metric_scope(.Generate_Chunk)
		start := time.tick_now()
		task.uniform, task.is_uniform = worldgen.generate(
			&task.gen,
			task.pos,
			task.array,
			&w.caches[context.user_index],
		)
		made := game.Chunk_Blocks {
			uniform = task.uniform,
		}
		if !task.is_uniform {made = {
				array = task.array,
			}}
		task.water = has_water(&made)
		task.ms = f32(time.duration_milliseconds(time.tick_since(start)))
	}
	base.queue_push(&w.done, task)
}

// has_water: whether any of blocks is water.
@(private)
has_water :: proc(blocks: ^game.Chunk_Blocks) -> bool {
	if blocks.array == nil {
		_, water := game.water_level(blocks.uniform)
		return water
	}
	for b in blocks.array {
		if _, water := game.water_level(b); water {return true}
	}
	return false
}
